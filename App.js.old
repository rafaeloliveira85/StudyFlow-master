// App.js
// Este e o ponto de entrada visual do aplicativo.
// Tudo que for renderizado aqui aparece dentro do app.
//
// Neste projeto, o App.js nao desenha uma tela diretamente.
// Ele prepara configuracoes globais e chama o arquivo de rotas.

import AppRoutes from "./src/navigation/AppRoutes";
import { SafeAreaProvider } from 'react-native-safe-area-context';

export default function App() {
  // SafeAreaProvider informa ao app as areas seguras da tela.
  // Isso evita que o conteudo fique atras da barra de status,
  // camera frontal, notch ou barra inferior do celular.
  return (
    <SafeAreaProvider>
      {/* AppRoutes controla qual tela aparece em cada momento. */}
      <AppRoutes />
    </SafeAreaProvider>
  );
}
